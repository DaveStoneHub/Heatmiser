# Waveshare ESP32-S3-Touch-LCD-7 (ESP32-S3-WROOM-1-N16R8)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# 1 ms ticks so bus timeouts and gaps are not rounded to 10 ms.
CONFIG_FREERTOS_HZ=1000

# Console on UART0 (the board's "UART" USB-C port), 115200.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
# The zone store's timers (hot water overrides, setpoints after a clock
# sync) log from the esp_timer task.
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096
CONFIG_CONSOLE_SORTED_HELP=y

# 8 MB octal PSRAM. Code and read-only data run from PSRAM (XIP), so flash
# writes (NVS, OTA) no longer stall the RGB panel's frame buffer reads.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# RGB panel: keep streaming while the cache is off, and resync the DMA every
# frame so a late bounce buffer cannot leave the picture shifted.
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y

# LVGL 9 (fonts and settings mirrored in tools/ui_preview/lv_conf.h)
CONFIG_LV_COLOR_DEPTH_16=y
# LVGL allocates from PSRAM (components/board/lv_mem_psram.c)
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
CONFIG_LV_DEF_REFR_PERIOD=20
# The Matter pairing QR code
CONFIG_LV_USE_QRCODE=y
# LVGL stays out of IRAM: internal RAM is kept for Wi-Fi, BLE and Matter.
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_USE_DEMO_WIDGETS=n

# ---- Matter (milestone 4) ---------------------------------------------------
# Commissioning over BLE (NimBLE), then Matter over Wi-Fi. BLE stays
# initialised (it stops advertising once paired): with BLE-only-for-
# commissioning, a paired bridge crashes at boot in CHIP's DeinitBLE, which
# calls into a NimBLE host that was never started.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_EXT_ADV=n
CONFIG_BT_NIMBLE_HCI_EVT_HI_BUF_COUNT=70
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING=n
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_MBEDTLS_HKDF_C=y
# Internal RAM is the tight resource: Matter, mbedTLS and NimBLE allocate
# from PSRAM.
CONFIG_ESP_MATTER_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Wi-Fi's static receive buffers must be internal (DMA) RAM, 1.6 KB each, and
# by then the screen's bounce buffers have taken their share. Ten is enough
# for a thermostat bridge; the dynamic buffers come from PSRAM.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
# Keep the Wi-Fi and lwIP fast paths out of IRAM. On the S3 IRAM and data RAM
# share the same SRAM, so this gives about 40 KB back to the heap; the bridge
# moves a few packets a second.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
# One BLE connection is all commissioning needs.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# The generated data model (esp-matter 1.5 and later); the bridge is written to it.
CONFIG_ESP_MATTER_ENABLE_GENERATED_DATA_MODEL=y
# 32 stats, the PRT/HW-N's hot water endpoint (milestone 5) and a spare.
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=34
# The bench console owns UART0; no CHIP shell. No soft AP either.
CONFIG_ENABLE_CHIP_SHELL=n
CONFIG_ENABLE_WIFI_AP=n
# Personal build: Matter test vendor ID and test attestation certificates.
CONFIG_DEVICE_VENDOR_ID=0xFFF1
CONFIG_DEVICE_PRODUCT_ID=0x8000
